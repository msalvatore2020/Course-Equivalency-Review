function openCourse(c){
  const o={kind:'tower', id:M.islandOf(c)+'|'+M.subOf(c)};
  if(selected && keyOf(selected)!==keyOf(o)) setGlow(selected,false);
  setGlow(o,true); selected=o;
  const f=focusFor(o); if(f) flyTo(f[0],f[1]);
  render({kind:'course'}, c); card.classList.add('open'); cB.scrollTop=0;
}

/* ---------- legend, search, mode switch ---------- */
const legend=document.getElementById('legend');
function buildLegend(){
  legend.innerHTML='';
  M.cats.forEach(c=>{
    const b=document.createElement('button'); b.className='chip'; b.style.color=M.color[c];
    b.innerHTML=`<i style="background:${M.color[c]}"></i><span style="color:var(--ink)">${M.label[c]}</span><b>${fmt(M.ALL.cat[c])}</b>`;
    b.onclick=()=>{ filterC = filterC===c?null:c; legend.querySelectorAll('.chip').forEach(x=>x.classList.toggle('on', x===b && filterC===c)); applyFilter(); if(filterC) select({kind:'cat', id:c}); };
    legend.appendChild(b);
  });
  const k=document.createElement('button'); k.className='chip'; k.style.color='#5cc8ff';
  k.innerHTML=`<i style="background:#2f8cff"></i><span style="color:var(--ink)">${M.key==='ge'?'Kean GE core':'Kean core'}</span><b>${fmt(M.items.length)}</b>`;
  k.onclick=()=>select({kind:'core'}); legend.appendChild(k);
}
function applyFilter(){
  Object.values(W.towers).forEach(t=>t.segs.forEach(s=>{
    const on=!filterC||s.userData.seg===filterC;
    s.material.opacity=on?1:.12; s.material.transparent=!on; s.userData.baseEI=on?(filterC?.9:.32):.02;
    s.material.emissiveIntensity=s.userData.baseEI; s.material.needsUpdate=true;
  }));
  W.streams.forEach((p,i)=>{ const c=new THREE.Color(M.color[p.cat]); const k=(!filterC||p.cat===filterC)?1:.08; W.sCol.set([c.r*k,c.g*k,c.b*k],i*3); });
  W.sGeo.attributes.color.needsUpdate=true;
}
const q=document.getElementById('q'), res=document.getElementById('results');
q.addEventListener('input', ()=>{
  const s=q.value.trim().toLowerCase();
  if(s.length<2){ res.hidden=true; return; }
  const hits=M.items.filter(c=>M.hay(c).includes(s)).slice(0,12);
  res.innerHTML = hits.length ? hits.map(c=>`<button data-i="${c.i}"><span class="code">${esc(c.c)}</span><span>${esc(c.t)}</span><span class="sub">${esc(M.sub(c))}</span></button>`).join('')
    : `<button disabled><span class="code">—</span><span>No match in this view. Try a course code or a word from the title.</span></button>`;
  res.hidden=false;
  res.querySelectorAll('[data-i]').forEach(b=>b.onclick=()=>{ res.hidden=true; q.blur(); openCourse(M.items[+b.dataset.i]); });
});
q.addEventListener('keydown', e=>{ if(e.key==='Enter'){ const b=res.querySelector('[data-i]'); b&&b.click(); } });
document.addEventListener('pointerdown', e=>{ if(!document.getElementById('search').contains(e.target)) res.hidden=true; });

document.getElementById('m-eq-n').textContent = fmt(EQ.length)+' rules';
document.getElementById('m-ge-n').textContent = fmt(GE.length)+' GE courses';
let switching=null;
function switchMode(key, after){
  if(W && W.M.key===key){ after&&after(); return; }
  closeCard(); filterC=null; hovered=null; tip.hidden=true;
  const old=W; W=WORLDS[key]; M=W.M;
  document.getElementById('m-eq').setAttribute('aria-pressed', key==='eq');
  document.getElementById('m-ge').setAttribute('aria-pressed', key==='ge');
  document.getElementById('eyebrow').textContent=M.eyebrow;
  document.getElementById('blurb').textContent=M.blurb;
  q.placeholder=M.search; q.value=''; res.hidden=true;
  buildLegend(); applyFilter();
  try{ history.replaceState(null,'', key==='ge'?'#ge':location.pathname+location.search); }catch(e){}
  if(old){ old.islands.forEach(i=>{ i.labelEl.hidden=true; i.labelEl.style.display='none'; }); }
  W.islands.forEach(i=>i.labelEl.hidden=false);
  switching={old, s:performance.now(), d:reduce?10:900, after};
  W.root.visible=true; W.root.scale.setScalar(old?0.001:1);
  W.t0 = performance.now() + (old?350:600);
  if(!reduce) Object.values(W.towers).forEach(t=>t.group.scale.y=0.001);
  if(old) flyTo(HOME.pos,HOME.tgt,1.2);
}

