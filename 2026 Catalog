  const names = Object.keys(M.byIsland).sort((a,b)=>M.byIsland[b].length-M.byIsland[a].length);
  M.islandOrder = names;
  const ring=[]; { const a=[...names]; while(a.length){ ring.push(a.shift()); if(a.length) ring.push(a.pop()); } }

  // core
