<title>NJCU–Kean Equivalency World</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;600&display=swap">
<style>
/* Layout: full-bleed WebGL world; HUD floats at corners; frosted stats card docks right (bottom sheet on phones). Single deliberate night look. */
:root{
  --night:#060a17; --night-2:#0c1430;
  --ink:#eef2ff; --ink-dim:#a3adc9; --ink-faint:#6c7697;
  --direct:#5cc8ff; --elective:#ffb547; --split:#c79bff; --dev:#ff7a9c; --mint:#6ee7c8;
  --glass:rgba(18,26,52,.52); --glass-edge:rgba(200,215,255,.16);
  --display:"Bricolage Grotesque", "Avenir Next", system-ui, sans-serif;
  --body:"Instrument Sans", "Segoe UI", system-ui, sans-serif;
  --mono:"JetBrains Mono", ui-monospace, Menlo, monospace;
  color-scheme:dark;
}
html,body{height:100%}
body{background:var(--night);color:var(--ink);font-family:var(--body);overflow:hidden;margin:0}
#stage{position:fixed;inset:0}
#stage canvas{display:block;touch-action:none}
.hud{position:fixed;z-index:5;pointer-events:none}
.hud > *{pointer-events:auto}
#brand{top:calc(16px + env(safe-area-inset-top,0px));left:max(16px,env(safe-area-inset-left,0px));max-width:min(440px,calc(100vw - 32px))}
#brand .eyebrow{font:600 11px/1 var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--ink-faint)}
#brand h1{font:800 clamp(24px,3.4vw,38px)/1.02 var(--display);margin:.35em 0 .3em;letter-spacing:-.01em;text-wrap:balance}
#brand h1 span{color:var(--direct)}
#brand p{margin:0;color:var(--ink-dim);font-size:13px;line-height:1.45;max-width:46ch}
#modes{display:inline-flex;gap:4px;padding:4px;margin:2px 0 12px;background:var(--glass);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border:1px solid var(--glass-edge);border-radius:14px}
#modes button{display:flex;flex-direction:column;align-items:flex-start;gap:3px;background:none;border:0;border-radius:10px;padding:7px 12px;color:var(--ink-dim);cursor:pointer;font:600 13px var(--body);transition:background .25s,color .25s}
#modes button small{font:500 10.5px var(--mono);letter-spacing:.04em;color:var(--ink-faint)}
#modes button[aria-pressed="true"]{background:rgba(92,200,255,.16);color:var(--ink);box-shadow:inset 0 0 0 1px rgba(92,200,255,.45)}
#modes button:focus-visible{outline:2px solid var(--direct);outline-offset:1px}
.progs{display:flex;flex-direction:column;gap:4px}
.prog{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center;text-align:left;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.06);border-radius:10px;padding:8px 10px;color:var(--ink);font:12.5px/1.35 var(--body);cursor:pointer}
.prog:hover,.prog:focus-visible{background:rgba(255,255,255,.08);outline:none}
.prog .pn{min-width:0}
.prog .pn .tag{font:600 9.5px var(--mono);letter-spacing:.08em;margin-left:6px;padding:1px 6px;border-radius:999px;border:1px solid currentColor;white-space:nowrap}
.prog b{font:600 11.5px var(--mono);color:var(--ink-dim)}
.cross{display:flex;flex-direction:column;gap:8px;background:rgba(110,231,200,.06);border:1px solid rgba(110,231,200,.22);border-radius:14px;padding:12px}
.cross h3{color:var(--mint)!important;font:600 10.5px/1 var(--mono)!important;letter-spacing:.14em;text-transform:uppercase;margin:0}
.kv{display:grid;grid-template-columns:110px 1fr;gap:5px 10px;font-size:12.5px}
.kv dt{color:var(--ink-faint);font:500 11px var(--mono);letter-spacing:.04em;padding-top:1px}
.kv dd{margin:0;min-width:0}
#search{margin-top:14px;position:relative;width:min(340px,calc(100vw - 32px))}
#search input{width:100%;box-sizing:border-box;background:var(--glass);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border:1px solid var(--glass-edge);border-radius:12px;color:var(--ink);font:14px var(--body);padding:10px 12px 10px 34px;outline:none}
#search input:focus{border-color:var(--direct);box-shadow:0 0 0 3px rgba(92,200,255,.18)}
#search svg{position:absolute;left:11px;top:12px;opacity:.7;z-index:1;pointer-events:none}
#results{position:absolute;top:calc(100% + 6px);left:0;right:0;background:rgba(14,20,42,.82);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border:1px solid var(--glass-edge);border-radius:12px;overflow:hidden;max-height:300px;overflow-y:auto}
#results button{display:grid;grid-template-columns:auto 1fr;gap:2px 10px;width:100%;text-align:left;background:none;border:0;color:var(--ink);padding:9px 12px;cursor:pointer;border-bottom:1px solid rgba(255,255,255,.05);font:13px var(--body)}
#results button:hover,#results button:focus-visible{background:rgba(92,200,255,.12);outline:none}
#results .code{font:600 12px var(--mono);color:var(--direct)}
#results .sub{grid-column:2;color:var(--ink-faint);font-size:11.5px}
#legend{bottom:calc(16px + env(safe-area-inset-bottom,0px));left:max(16px,env(safe-area-inset-left,0px));display:flex;flex-wrap:wrap;gap:8px;max-width:calc(100vw - 32px)}
.chip{display:inline-flex;align-items:center;gap:8px;background:var(--glass);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border:1px solid var(--glass-edge);border-radius:999px;padding:7px 12px 7px 10px;color:var(--ink);font:500 12.5px var(--body);cursor:pointer;transition:border-color .2s,transform .2s}
.chip:hover{transform:translateY(-1px);border-color:rgba(255,255,255,.35)}
.chip:focus-visible{outline:2px solid var(--direct);outline-offset:2px}
.chip.on{border-color:currentColor}
.chip i{width:10px;height:10px;border-radius:3px;display:block;box-shadow:0 0 10px currentColor}
.chip b{font:600 12px var(--mono);color:var(--ink-dim)}
#controls{bottom:calc(16px + env(safe-area-inset-bottom,0px));right:max(16px,env(safe-area-inset-right,0px));display:flex;gap:8px;align-items:center}
#hint{font:12px var(--body);color:var(--ink-faint);margin-right:6px}
#labels{position:fixed;inset:0;pointer-events:none;z-index:3}
.isl-label{position:absolute;transform:translate(-50%,-100%);pointer-events:auto;cursor:pointer;background:none;border:0;color:var(--ink);font:700 13px var(--display);letter-spacing:.04em;text-transform:uppercase;white-space:nowrap;text-shadow:0 2px 12px rgba(0,0,0,.9);padding:4px 6px;transition:opacity .3s}
.isl-label small{display:block;font:500 10.5px var(--mono);letter-spacing:.08em;color:var(--ink-dim);text-transform:none}
.isl-label:focus-visible{outline:2px solid var(--direct);border-radius:6px}
#tip{position:fixed;z-index:6;pointer-events:none;background:rgba(10,14,32,.85);border:1px solid var(--glass-edge);border-radius:10px;padding:7px 10px;font:12px var(--body);color:var(--ink);transform:translate(14px,14px);white-space:nowrap}
#tip b{font:600 12px var(--mono);color:var(--direct)}

/* Frosted stats card */
#card{position:fixed;z-index:8;top:calc(16px + env(safe-area-inset-top,0px));right:max(16px,env(safe-area-inset-right,0px));bottom:calc(16px + env(safe-area-inset-bottom,0px));width:min(400px,calc(100vw - 32px));
  background:linear-gradient(160deg,rgba(40,54,100,.42),rgba(12,18,40,.5));backdrop-filter:blur(22px) saturate(150%);-webkit-backdrop-filter:blur(22px) saturate(150%);
  border:1px solid var(--glass-edge);border-radius:20px;box-shadow:0 30px 80px rgba(0,0,0,.45), inset 0 1px 0 rgba(255,255,255,.12);
  display:flex;flex-direction:column;overflow:hidden;transform:translateX(calc(100% + 40px));opacity:0;transition:transform .55s cubic-bezier(.2,.9,.2,1),opacity .4s}
#card.open{transform:none;opacity:1}
#card header{padding:20px 20px 14px;border-bottom:1px solid rgba(255,255,255,.08);position:relative}
#card .kicker{font:600 10.5px/1 var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--ink-faint)}
#card h2{font:800 30px/1.02 var(--display);margin:.3em 0 .15em;letter-spacing:-.01em;padding-right:36px;text-wrap:balance}
#card .lede{color:var(--ink-dim);font-size:13px;line-height:1.45}
#close{position:absolute;top:14px;right:14px;width:32px;height:32px;border-radius:10px;border:1px solid var(--glass-edge);background:rgba(255,255,255,.04);color:var(--ink);cursor:pointer;font-size:18px;line-height:1}
#close:hover{background:rgba(255,255,255,.1)}
#card .body{padding:16px 20px 22px;overflow-y:auto;display:flex;flex-direction:column;gap:18px;min-height:0}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.stat{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:12px;padding:10px 10px 9px;min-width:0}
.stat .n{font:700 22px/1 var(--display);font-variant-numeric:tabular-nums}
.stat .l{font:500 10.5px/1.25 var(--body);color:var(--ink-faint);margin-top:5px;text-transform:uppercase;letter-spacing:.06em}
.sec h3{font:600 10.5px/1 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--ink-faint);margin:0 0 9px}
.mix{display:flex;height:12px;border-radius:6px;overflow:hidden;background:rgba(255,255,255,.06)}
.mix span{display:block;height:100%;transform-origin:left;animation:grow .8s cubic-bezier(.2,.9,.2,1) both}
@keyframes grow{from{transform:scaleX(0)}}
.mixkey{display:flex;flex-wrap:wrap;gap:6px 14px;margin-top:8px;font-size:12px;color:var(--ink-dim)}
.mixkey em{font-style:normal;font-family:var(--mono);color:var(--ink)}
.mixkey i{display:inline-block;width:8px;height:8px;border-radius:2px;margin-right:6px;vertical-align:0}
.bars{display:flex;flex-direction:column;gap:6px}
.bar{display:grid;grid-template-columns:minmax(92px,44%) 1fr 40px;gap:8px;align-items:center;font-size:12.5px;background:none;border:0;color:var(--ink);padding:0;text-align:left;font-family:var(--body)}
button.bar{cursor:pointer;border-radius:6px}
button.bar:hover .track b{filter:brightness(1.3)}
button.bar:focus-visible{outline:2px solid var(--direct)}
.bar .k{font:600 11.5px var(--mono);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bar .track{height:8px;background:rgba(255,255,255,.06);border-radius:4px;overflow:hidden}
.bar .track b{display:block;height:100%;border-radius:4px;transform-origin:left;animation:grow .9s cubic-bezier(.2,.9,.2,1) both}
.bar .v{font:600 11.5px var(--mono);text-align:right;color:var(--ink-dim);font-variant-numeric:tabular-nums}
.filters{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px}
.filters button{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);color:var(--ink-dim);border-radius:999px;padding:4px 10px;font:500 11.5px var(--body);cursor:pointer}
.filters button.on{color:var(--ink);border-color:rgba(255,255,255,.4);background:rgba(255,255,255,.1)}
.courses{display:flex;flex-direction:column;gap:2px}
.crow{display:grid;grid-template-columns:8px 72px 1fr;gap:4px 9px;align-items:start;padding:8px 6px;border-radius:8px;background:none;border:0;color:var(--ink);text-align:left;cursor:pointer;font:12.5px/1.35 var(--body)}
.crow:hover,.crow:focus-visible{background:rgba(255,255,255,.06);outline:none}
.crow i{width:8px;height:8px;border-radius:2px;margin-top:4px}
.crow .cc{font:600 11.5px var(--mono)}
.crow .ct{min-width:0}
.crow .ct small{display:block;font:11px var(--mono);color:var(--ink-faint);margin-top:2px}
.flow{display:grid;grid-template-columns:1fr auto 1fr;gap:10px;align-items:center}
.node{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:14px;padding:12px;min-width:0}
.node .who{font:600 10px var(--mono);letter-spacing:.14em;color:var(--ink-faint);text-transform:uppercase}
.node .cd{font:700 18px/1.1 var(--mono);margin:6px 0 4px;word-break:break-all}
.node .cr{font-size:12px;color:var(--ink-dim)}
.arrow{font:700 22px var(--display);color:var(--direct)}
.note{font-size:12.5px;line-height:1.5;color:var(--ink-dim);background:rgba(255,255,255,.035);border-left:2px solid var(--direct);padding:9px 12px;border-radius:0 8px 8px 0}
.pill{display:inline-block;font:600 10.5px var(--mono);letter-spacing:.06em;padding:3px 8px;border-radius:999px;border:1px solid currentColor;margin-right:6px}
.btn{background:var(--glass);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border:1px solid var(--glass-edge);color:var(--ink);border-radius:10px;padding:8px 12px;font:500 12.5px var(--body);cursor:pointer}
.btn:hover{border-color:rgba(255,255,255,.35)}
.btn:focus-visible{outline:2px solid var(--direct)}
#loading{position:fixed;inset:0;display:grid;place-items:center;z-index:20;background:var(--night);font:600 12px var(--mono);letter-spacing:.2em;color:var(--ink-faint);transition:opacity .8s}
#loading.gone{opacity:0;pointer-events:none}

@media (max-width:720px){
  #brand p{display:none}
  #hint{display:none}
  #card{top:auto;left:max(12px,env(safe-area-inset-left,0px));right:max(12px,env(safe-area-inset-right,0px));width:auto;height:min(64vh,560px);transform:translateY(calc(100% + 40px))}
  #legend{bottom:calc(62px + env(safe-area-inset-bottom,0px))}
  .chip{padding:6px 10px 6px 9px;font-size:12px}
  .isl-label{font-size:11px}
}
@media (prefers-reduced-motion:reduce){ .mix span,.bar .track b{animation:none} #card{transition:opacity .2s} }
</style>

