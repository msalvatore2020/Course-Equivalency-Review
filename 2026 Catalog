/* ---------- loop ---------- */
const clock=new THREE.Clock(); let T=0;
switchMode(location.hash==='#ge'?'ge':'eq');
flyTo(HOME.pos,HOME.tgt,3.2);
requestAnimationFrame(()=>document.getElementById('loading').classList.add('gone'));

function animate(){
  requestAnimationFrame(animate);
  const dt=Math.min(clock.getDelta(),0.05); T+=dt; const now=performance.now();
  if(tween){ const k=Math.min(1,(now-tween.s)/tween.d), e=ease(k); camera.position.lerpVectors(tween.p0,tween.p1,e); controls.target.lerpVectors(tween.t0,tween.t1,e); if(k>=1) tween=null; }
  if(switching){ const k=Math.min(1,(now-switching.s)/switching.d);
    if(switching.old){ const ko=Math.min(1,k*2); switching.old.root.scale.setScalar(Math.max(0.001,1-ease(ko))); switching.old.root.rotation.y+=dt*2*(1-ko);
      const kn=Math.max(0,(k-.35)/.65); W.root.scale.setScalar(Math.max(0.001,ease(kn))); }
    if(k>=1){ if(switching.old){ switching.old.root.visible=false; switching.old.root.scale.setScalar(1); switching.old.root.rotation.y=0; } W.root.scale.setScalar(1); const a=switching.after; switching=null; a&&a(); } }

  const amp=reduce?0:1, since=(now-W.t0)/1000;
  W.islands.forEach(isl=>{ isl.group.position.y=isl.base.y+Math.sin(T*0.45+isl.phase)*0.7*amp; isl.group.rotation.y=Math.sin(T*0.12+isl.phase)*0.05*amp; });
  W.core.rotation.y+=dt*0.15*amp; W.coreMesh.rotation.x+=dt*0.2*amp; W.coreShell.rotation.y-=dt*0.25*amp;
  W.coreMesh.scale.setScalar(1+Math.sin(T*1.6)*0.035*amp);
  W.rings.forEach((r,i)=>{ r.m.rotation.z+=dt*(0.2+i*0.08)*(i%2?-1:1)*amp; r.hit.rotation.copy(r.m.rotation); });
  stars.rotation.y+=dt*0.004*amp;

  for(const t of Object.values(W.towers)){
    if(!reduce){ const k=Math.min(1,Math.max(0,(since-t.delay)/1.1)); const e=1-Math.pow(1-k,3);
      const big=(hovered&&hovered.kind==='tower'&&hovered.id===t.id)||(selected&&selected.kind==='tower'&&selected.id===t.id)?1.06:1;
      t.group.scale.y += ((e*big)-t.group.scale.y)*0.18; }
    const d=camera.position.distanceTo(worldPos(t.group));
    t.label.material.opacity=THREE.MathUtils.clamp((95-d)/30,0,1);
    t.label.scale.y=t.label.userData.h/Math.max(t.group.scale.y,.05);
  }
  for(let i=0;i<W.streams.length;i++){ const p=W.streams[i]; p.t+=dt*p.sp*amp; if(p.t>1)p.t-=1;
    bez(W,p.isl,p.t,_v,p.off*4); _v.x+=Math.sin(T*2+p.wob)*0.25; _v.z+=Math.cos(T*2+p.wob)*0.25;
    W.sPos[i*3]=_v.x; W.sPos[i*3+1]=_v.y; W.sPos[i*3+2]=_v.z; }
  W.sGeo.attributes.position.needsUpdate=true;
  W.lines.forEach(({line,isl})=>{ const a=line.geometry.attributes.position; for(let j=0;j<a.count;j++){ bez(W,isl,j/(a.count-1),_v); a.setXYZ(j,_v.x,_v.y,_v.z);} a.needsUpdate=true; });

  const sc = W.root.scale.x;
  W.islands.forEach(isl=>{ const p=worldPos(isl.group); p.y+=4.5*sc; p.project(camera);
    const vis=!switching && p.z<1 && Math.abs(p.x)<1.1 && Math.abs(p.y)<1.1;
    isl.labelEl.style.display=vis?'block':'none';
    if(vis){ isl.labelEl.style.left=((p.x+1)/2*innerWidth)+'px'; isl.labelEl.style.top=((1-p.y)/2*innerHeight)+'px';
      const d=camera.position.distanceTo(isl.group.position); isl.labelEl.style.opacity=d<22?.25:1; } });

  controls.update(); composer.render();
}
animate();
addEventListener('resize', ()=>{ camera.aspect=innerWidth/innerHeight; camera.updateProjectionMatrix(); renderer.setSize(innerWidth,innerHeight); composer.setSize(innerWidth,innerHeight); bloom.setSize(innerWidth,innerHeight); });
</script>
