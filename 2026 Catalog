function courseRow(c){
  const sub = M.key==='eq' ? `→ ${esc([c.k1,c.k2].filter(Boolean).join(' + '))} · ${c.cr} cr · ${c.lv}${c.ct==='TD'?' · developmental':''}`
    : `→ ${esc(c.k||'no equivalent')} · converted ${esc(c.conv)} · ${esc(c.plo)}`;
  return `<button class="crow" data-course="${c.i}"><i style="background:${M.color[M.catOf(c)]}"></i><span class="cc">${esc(c.c)}</span><span class="ct">${esc(c.t)}<small>${sub}</small></span></button>`;
}
function coursesBlock(list){
  const f=['all',...M.cats.filter(c=>list.some(x=>M.catOf(x)===c))];
  return `<div class="sec"><h3>All ${fmt(list.length)} ${M.key==='ge'?'GE courses':'equivalencies'}</h3><div class="filters">${f.map((c,i)=>`<button data-f="${c}" class="${i?'':'on'}">${c==='all'?'All':M.label[c]}</button>`).join('')}</div><div class="courses" id="clist">${list.map(courseRow).join('')}</div></div>`;
}
function wire(list){
  cB.querySelectorAll('[data-kind]').forEach(b=>b.onclick=()=>select({kind:b.dataset.kind, id:b.dataset.id}));
  cB.querySelectorAll('[data-course]').forEach(b=>b.onclick=()=>openCourse(M.items[+b.dataset.course]));
  cB.querySelectorAll('[data-prog]').forEach(b=>b.onclick=()=>select({kind:'program', id:b.dataset.prog}));
  cB.querySelectorAll('[data-jump]').forEach(b=>b.onclick=()=>{ const [mode,i]=b.dataset.jump.split(':'); switchMode(mode, ()=>openCourse(MODES[mode].items[+i])); });
  cB.querySelectorAll('[data-f]').forEach(b=>b.onclick=()=>{
    cB.querySelectorAll('[data-f]').forEach(x=>x.classList.toggle('on',x===b));
    const f=b.dataset.f, el=document.getElementById('clist');
    el.innerHTML = list.filter(c=>f==='all'||M.catOf(c)===f).map(courseRow).join('');
    el.querySelectorAll('[data-course]').forEach(x=>x.onclick=()=>openCourse(M.items[+x.dataset.course]));
  });
}
const note = s => `<div class="note">${s}</div>`;

