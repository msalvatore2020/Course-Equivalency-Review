  const cl = textSprite(M.coreName,'#ffffff',56); cl.position.set(0,8.2,0); cl.scale.multiplyScalar(2.2); core.add(cl);

  M.rings.forEach((rg,i)=>{
    const share = M.items.filter(rg.test).length/M.items.length;
    const r = 8.5+i*2.5, tube = 0.09+share*0.45;
    const m = new THREE.Mesh(new THREE.TorusGeometry(r,tube,12,160), new THREE.MeshStandardMaterial({color:rg.color, emissive:rg.color, emissiveIntensity:.8, transparent:true, opacity:.85, roughness:.3}));
    m.rotation.x = Math.PI/2+(i-1)*0.32; m.rotation.y=(i-1)*0.25; m.userData={kind:'ring', id:rg.id};
    const hit = new THREE.Mesh(new THREE.TorusGeometry(r,1.1,6,60), new THREE.MeshBasicMaterial({visible:false})); hit.userData={kind:'ring', id:rg.id};
    core.add(m); core.add(hit); W.pickables.push(m,hit); W.rings.push({m,hit,id:rg.id});
  });

  // islands
  const SP=2.25;
  const radii = ring.map(n=>SP*Math.sqrt(Object.keys(countBy(M.byIsland[n],M.subOf)).length)+2.6);
  const R = Math.max(34, radii.reduce((s,r)=>s+2*r+5,0)/(2*Math.PI));
  ring.forEach((name,idx)=>{
    const list=M.byIsland[name];
    const subs = sortE(countBy(list,M.subOf)).map(e=>e[0]);
    const rad = radii[idx];
    const ang = idx/ring.length*Math.PI*2 - Math.PI/2;
    const base = new THREE.Vector3(Math.cos(ang)*R, (idx%2?1.5:-1.5), Math.sin(ang)*R);
    const g = new THREE.Group(); g.position.copy(base); W.root.add(g);
    const top = new THREE.Mesh(new THREE.CylinderGeometry(rad,rad*.94,1.1,7,1), new THREE.MeshStandardMaterial({color:'#1e2a4f', roughness:.85, metalness:.05, flatShading:true}));
    top.position.y=-0.55; top.rotation.y=idx; top.userData={kind:'island', id:name}; g.add(top);
    const under = new THREE.Mesh(new THREE.ConeGeometry(rad*.93, rad*1.15, 7, 3), new THREE.MeshStandardMaterial({color:'#121a35', roughness:1, flatShading:true}));
    under.rotation.x=Math.PI; under.rotation.y=idx; under.position.y=-1.1-rad*1.15/2; under.userData={kind:'island', id:name}; g.add(under);
    { const p=under.geometry.attributes.position; for(let i=0;i<p.count;i++){ if(p.getY(i)<rad*.5){ p.setX(i,p.getX(i)*(0.85+Math.random()*.3)); p.setZ(i,p.getZ(i)*(0.85+Math.random()*.3)); } } under.geometry.computeVertexNormals(); }
    W.pickables.push(top,under);
    const warn = /No Recommendation|Needs Review/.test(name);
    const edgeCol = warn ? '#ff7a9c' : '#8fb2ff';
    const edge = new THREE.Mesh(new THREE.TorusGeometry(rad*.985,0.07,6,7), new THREE.MeshBasicMaterial({color:edgeCol,transparent:true,opacity:.55}));
    edge.rotation.x=Math.PI/2; edge.rotation.z=idx; edge.position.y=0.01; g.add(edge);
    const isl = {name, group:g, base, radius:rad, edge, edgeCol, subs, phase:idx*0.9, list};
    W.islands.push(isl);

    subs.forEach((s,i)=>{
      const r = i===0?0:SP*Math.sqrt(i+0.15), a=i*2.39996+idx;
      const tg = new THREE.Group(); tg.position.set(Math.cos(a)*r,0,Math.sin(a)*r); g.add(tg);
      const tl = list.filter(x=>M.subOf(x)===s); const st=agg(M,tl);
      const H = M.height(st.n); const id = name+'|'+s;
      let y=0; const segs=[];
      M.cats.forEach(c=>{
        if(!st.cat[c]) return; const h=H*st.cat[c]/st.n;
        const mat = new THREE.MeshStandardMaterial({color:M.color[c], emissive:M.color[c], emissiveIntensity:.32, roughness:.35, metalness:.15, flatShading:true});
        const mesh = new THREE.Mesh(hexGeo, mat); mesh.scale.set(1,h,1); mesh.position.y=y; y+=h;
        mesh.userData={kind:'tower', id, seg:c, baseEI:.32}; tg.add(mesh); W.pickables.push(mesh); segs.push(mesh);
      });
      const cap = new THREE.Mesh(new THREE.CylinderGeometry(0.86,0.86,0.06,6), new THREE.MeshBasicMaterial({color:'#c4d3f5',transparent:true,opacity:.45}));
      cap.position.y=H; cap.userData={kind:'tower', id}; tg.add(cap); W.pickables.push(cap);
      const lab = textSprite(s); lab.position.set(0,H+0.75,0); tg.add(lab);
      tg.scale.y = reduce?1:0.001;
      W.towers[id] = {id, sub:s, group:tg, segs, cap, label:lab, island:isl, height:H, delay:idx*0.12+i*0.05, st, list:tl};
    });

    const el = document.createElement('button'); el.className='isl-label'; el.hidden=true;
    el.innerHTML = `${esc(name)}<small>${fmt(list.length)} courses · ${subs.length} subjects</small>`;
    if(warn) el.style.color='#ffb3c4';
    el.addEventListener('click', ()=>select({kind:'island', id:name}));
    labelsEl.appendChild(el); isl.labelEl=el;

    const n = Math.max(6, Math.round(list.length/M.streamDiv));
    for(let k=0;k<n;k++){ const c=list[Math.floor(Math.random()*list.length)];
      W.streams.push({isl, t:Math.random(), sp:0.05+Math.random()*0.07, cat:M.catOf(c), wob:Math.random()*Math.PI*2, off:(Math.random()-.5)*2.2}); }
    const lg = new THREE.BufferGeometry().setFromPoints(new Array(48).fill(0).map(()=>new THREE.Vector3()));
    const line = new THREE.Line(lg, new THREE.LineBasicMaterial({color:'#4f78c8',transparent:true,opacity:.28})); W.root.add(line); W.lines.push({line,isl});
  });
  W.sPos = new Float32Array(W.streams.length*3); W.sCol = new Float32Array(W.streams.length*3);
  W.sGeo = new THREE.BufferGeometry();
  W.sGeo.setAttribute('position', new THREE.BufferAttribute(W.sPos,3));
